root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{html,css,js,json,xml,yml,yaml,md,txt,svg}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.ps1]
charset = utf-8-bom
end_of_line = crlf
indent_style = space
indent_size = 4
